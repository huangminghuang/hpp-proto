_ZN9hpp_proto22shift_mix_parse_varintIjLi4ETkNS_8concepts21contiguous_byte_rangeENS_13pb_serializer19input_buffer_regionISt4byteEEEEDTclL_ZNSt3__16ranges5__cpo5cdataEEfp_EERKT1_Rl:
  123|  6.24M|    -> decltype(std::ranges::cdata(input)) {
  124|       |  // The algorithm relies on sign extension for each byte to set all high bits
  125|       |  // when the varint continues. It also relies on asserting all of the lower
  126|       |  // bits for each successive byte read. This allows the result to be aggregated
  127|       |  // using a bitwise AND. For example:
  128|       |  //
  129|       |  //          8       1          64     57 ... 24     17  16      9  8       1
  130|       |  // ptr[0] = 1aaa aaaa ; res1 = 1111 1111 ... 1111 1111  1111 1111  1aaa aaaa
  131|       |  // ptr[1] = 1bbb bbbb ; res2 = 1111 1111 ... 1111 1111  11bb bbbb  b111 1111
  132|       |  // ptr[2] = 0ccc cccc ; res3 = 0000 0000 ... 000c cccc  cc11 1111  1111 1111
  133|       |  //                             ---------------------------------------------
  134|       |  //        res1 & res2 & res3 = 0000 0000 ... 000c cccc  ccbb bbbb  baaa aaaa
  135|       |  //
  136|       |  // On x86-64, a shld from a single register filled with enough 1s in the high
  137|       |  // bits can accomplish all this in one instruction. It so happens that res1
  138|       |  // has 57 high bits of ones, which is enough for the largest shift done.
  139|       |  //
  140|       |  // Just as importantly, by keeping results in res1, res2, and res3, we take
  141|       |  // advantage of the superscalar abilities of the CPU.
  142|  6.24M|  auto p = std::ranges::cdata(input);
  143|  6.24M|  const auto next = [&p] { return static_cast<const int8_t>(*p++); };
