_ZN9hpp_proto11varint_sizeILNS_15varint_encodingE0EjEEDaT0_:
   42|  50.2k|constexpr auto varint_size(auto value) {
   43|       |  if constexpr (Encoding == varint_encoding::zig_zag) {
   44|       |    return varint_size(std::make_unsigned_t<decltype(value)>(
   45|       |        (value << 1) ^ (value >> ((sizeof(value) * CHAR_BIT) - 1)))); // // NOLINT(hicpp-signed-bitwise)
   46|  50.2k|  } else {
   47|  50.2k|    return ((sizeof(value) * CHAR_BIT) -
   48|  50.2k|            static_cast<unsigned>(std::countl_zero(std::make_unsigned_t<decltype(value)>(value) | 1U)) +
   49|  50.2k|            (CHAR_BIT - 2)) /
   50|       |           (CHAR_BIT - 1);
